///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
}

///|
async fn main {
  assert_eq(@process.run("moon", ["package"]), 0)
  let archive = @fs.realpath("_build/publish/Delthin-moon_repomix-0.5.1.zip")
  let temp = @fs.tmpdir(prefix="moon-repomix-source-")
  defer @fs.rmdir(temp, recursive=true)
  assert_eq(@process.run("unzip", ["-q", archive, "-d", temp]), 0)
  // The extracted demo builds the native sources. Check only non-build assets here.
  for
    path in [
      "examples/demo/.gitignore", "examples/demo/debug.log", "examples/demo/src/.gitignore",
      "examples/demo/src/scratch.txt", "LICENSES/tree-sitter-ICU.txt",
      "src/compression/vendor/moonbit/grammar.patch", "LICENSES/tree-sitter-moonbit-Apache-2.0.txt",
      "LICENSES/tree-sitter-go-MIT.txt", "LICENSES/tree-sitter-rust-MIT.txt",
      "LICENSES/tree-sitter-java-MIT.txt", "docs/mcp.md", "docs/reports.md",
      "docs/webui.md", "docs/code-context.md", "docs/task-context.md",
      "assets/webui/index.html", "assets/webui/app.css", "assets/webui/app.js",
      "assets/demo/webui.gif",
    ] {
    assert_true(@fs.exists(temp + "/" + path))
  }
  assert_eq(@process.run("moon", ["update"], cwd=temp), 0)
  assert_eq(
    @process.run(
      "moon",
      ["run", "--target", "native", "scripts/demo.mbtx"],
      cwd=temp,
    ),
    0,
  )
  println(
    "PASS: source archive includes fixtures and runs the demo after extraction",
  )
}
