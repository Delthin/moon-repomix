///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
}

///|
async fn main {
  assert_eq(@process.run("moon", ["package"]), 0)
  let archive = @fs.realpath("_build/publish/delthin-moon_repomix-0.1.0.zip")
  let temp = @fs.tmpdir(prefix="moon-repomix-source-")
  defer @fs.rmdir(temp, recursive=true)
  assert_eq(@process.run("unzip", ["-q", archive, "-d", temp]), 0)
  // Ignore fixtures must survive packaging, even though Git ignores them.
  for path in [
    "examples/demo/.gitignore",
    "examples/demo/debug.log",
    "examples/demo/src/.gitignore",
    "examples/demo/src/scratch.txt",
  ] {
    assert_true(@fs.exists(temp + "/" + path))
  }
  assert_eq(@process.run("moon", ["update"], cwd=temp), 0)
  assert_eq(
    @process.run("moon", ["run", "--target", "native", "scripts/demo.mbtx"], cwd=temp),
    0,
  )
  println("PASS: source archive includes fixtures and runs the demo after extraction")
}
