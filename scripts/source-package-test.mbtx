///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
}

///|
async fn main {
  assert_eq(@process.run("moon", ["package"]), 0)
  let archive = @fs.realpath("_build/publish/Delthin-moon_repomix-0.4.1.zip")
  let temp = @fs.tmpdir(prefix="moon-repomix-source-")
  defer @fs.rmdir(temp, recursive=true)
  assert_eq(@process.run("unzip", ["-q", archive, "-d", temp]), 0)
  // Source archives retain ignored fixtures and the native parser's resources.
  for
    path in [
      "examples/demo/.gitignore", "examples/demo/debug.log", "examples/demo/src/.gitignore",
      "examples/demo/src/scratch.txt", "src/compression/compression_core.h", "src/compression/vendor/runtime/lib/include/tree_sitter/api.h",
      "src/compression/vendor/typescript/tsx/src/parser.c", "LICENSES/tree-sitter-ICU.txt",
      "src/compression/vendor/moonbit/grammar.patch", "src/compression/vendor/moonbit/src/parser.c",
      "src/compression/vendor/moonbit/src/scanner.c", "src/compression/vendor/moonbit/src/tree_sitter/alloc.h",
      "src/compression/vendor/moonbit/src/tree_sitter/array.h", "src/compression/vendor/moonbit/src/tree_sitter/parser.h",
      "LICENSES/tree-sitter-moonbit-Apache-2.0.txt", "src/compression/vendor/go/src/parser.c",
      "src/compression/vendor/rust/src/parser.c", "src/compression/vendor/rust/src/scanner.c",
      "src/compression/vendor/java/src/parser.c", "LICENSES/tree-sitter-go-MIT.txt",
      "LICENSES/tree-sitter-rust-MIT.txt", "LICENSES/tree-sitter-java-MIT.txt", "src/platform/directory.c",
      "src/partition/reindex.mbt", "src/mcp/server.mbt", "src/mcp_rpc/dispatch.mbt",
      "docs/mcp.md", "docs/reports.md", "docs/webui.md", "assets/webui/index.html",
      "assets/webui/app.css", "assets/webui/app.js", "assets/demo/webui.gif", "src/validated_text/text.mbt",
      "src/file_pipeline.mbt", "src/metrics/native_counter.c", "src/metrics/native_counter.h",
      "src/metrics/native_counter_ffi.c", "src/metrics/native_pretokenize.h", "src/metrics/count_session.mbt",
      "src/security/prefilter.c", "src/security/prefilter.h", "src/compression/worker_pool.c",
      "src/compression/worker_pool.h", "src/compression/worker_ffi.c", "src/compression/sc_atomic.h",
      "src/compression/compression_predicates.h",
    ] {
    assert_true(@fs.exists(temp + "/" + path))
  }
  assert_eq(@process.run("moon", ["update"], cwd=temp), 0)
  assert_eq(
    @process.run(
      "moon",
      ["run", "--target", "native", "scripts/demo.mbtx"],
      cwd=temp,
    ),
    0,
  )
  println(
    "PASS: source archive includes fixtures and runs the demo after extraction",
  )
}
