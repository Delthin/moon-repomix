///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
}

///|
async fn smoke(binary : String, cwd : String) -> Unit {
  let (code, stdout, stderr) = @process.collect_output(
    binary,
    [".", "--stdout", "--quiet", "--compress"],
    cwd~,
  )
  assert_eq(code, 0)
  assert_true(stdout.text().contains("path=\"你好.txt\""))
  assert_true(stdout.text().contains("hello 😀"))
  assert_true(stdout.text().contains("installedOutline"))
  assert_false(stdout.text().contains("value += 1;"))
  assert_eq(stderr.text(), "")
}

///|
async fn check_webui(prefix : String) -> Unit {
  for name in ["index.html", "app.css", "app.js"] {
    assert_eq(
      @fs.read_file(prefix + "/share/moon-repomix/webui/" + name).text(),
      @fs.read_file("assets/webui/" + name).text(),
    )
  }
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 2 || args.length() == 3 else {
    fail(
      "Usage: moon run --target native scripts/distribution-test.mbtx PLATFORM [ARCHIVE_DIR]",
    )
  }
  let platform = args[1]
  let windows = @env.get_env_var("OS") == Some("Windows_NT")
  let suffix = if windows { ".exe" } else { "" }
  let temp = @fs.tmpdir(prefix="moon-repomix-install-")
  defer @fs.rmdir(temp, recursive=true)
  let prefix = temp + "/安装 空间"
  let fixture = temp + "/项目"
  @fs.mkdir(fixture)
  @fs.write_file(fixture + "/你好.txt", "hello 😀", create_mode=CreateNew)
  @fs.write_file(
    fixture + "/outline.ts",
    "export function installedOutline(value: number): number {\n" +
    "  value += 1;\n".repeat(60) +
    "  return value;\n}\n",
    create_mode=CreateNew,
  )
  let installed = @process.run("moon", [
    "run", "--target", "native", "scripts/install.mbtx", prefix,
  ])
  assert_eq(installed, 0)
  check_webui(prefix)
  smoke(prefix + "/bin/moon-repomix" + suffix, fixture)
  let moved = temp + "/relocated"
  @fs.rename(prefix, moved)
  check_webui(moved)
  smoke(moved + "/bin/moon-repomix" + suffix, fixture)
  if !windows {
    let link = temp + "/alias"
    @fs.symlink(target=moved + "/bin/moon-repomix", link)
    smoke(link, fixture)
  }
  // CI uploads this verified archive rather than packaging a second copy.
  let distribution = if args.length() == 3 { args[2] } else { temp + "/dist" }
  let packed = @process.run("moon", [
    "run", "--target", "native", "scripts/package.mbtx", distribution, platform,
  ])
  assert_eq(packed, 0)
  let unpacked = temp + "/unpacked"
  @fs.mkdir(unpacked)
  let unpack = @process.run("tar", [
    "-xzf",
    distribution + "/moon-repomix-" + platform + ".tar.gz",
    "-C",
    unpacked,
  ])
  assert_eq(unpack, 0)
  for
    license in [
      "runtime-MIT.txt", "javascript-MIT.txt", "typescript-MIT.txt", "python-MIT.txt",
      "ICU.txt", "sources.md",
    ] {
    assert_true(
      @fs.exists(
        unpacked +
        "/moon-repomix-" +
        platform +
        "/LICENSES/tree-sitter-" +
        license,
      ),
    )
  }
  check_webui(unpacked + "/moon-repomix-" + platform)
  assert_true(@fs.exists(unpacked + "/moon-repomix-" + platform + "/assets/demo/webui.gif"))
  smoke(
    unpacked + "/moon-repomix-" + platform + "/bin/moon-repomix" + suffix,
    fixture,
  )
  println(
    "PASS: install, relocation, WebUI assets, native compression, parser licenses and extracted archive",
  )
}
