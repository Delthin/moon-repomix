  {
    "chi/chain.go": "8c22d7bbc23f4b4d46ded5ef721a9c3a173031fa2c2c9a7b48c46c2b07e8bd80",
    "chi/chi.go": "982bcc7cae8692d1b15758af7904726f7b42fbbfdac303898b650648effeac19",
    "chi/context.go": "b453c9c10998064775d2d9886a30d37f1d42a39555ef7b52847af4952fa90f56",
    "chi/mux.go": "deede9b38b5c795917ad8c5e19fc3af60d93892531d723756070691c556e5261",
    "chi/path_value.go": "65b18317b5b9ee2b08e43191ed0c2a82a44ca8c7d99ebb4e74b523a7896e5d3f",
    "chi/path_value_fallback.go": "fab0a8526b3edb3d7496ee648e242383055621691279b5b7edb24a2cf7b4fc14",
    "chi/tree.go": "c9d30f2137156909b767e05cea6e150a9fdee6e287eb6c1adc19e9f92b99f045",
    "chi/LICENSE": "a2d51b7515acfaff2f7a88688650f2fc4fd99561383e72bba2305e3db59a1647",
    "itoa/src/lib.rs": "ef9f1a8665a678cf5b77bcaa628d00538d620de0c84fd2a8b92323a314a95636",
    "itoa/src/udiv128.rs": "d28c1872c37ee2185931babcb20a221b8706a5aa8abc4963419763888023ff17",
    "itoa/LICENSE-MIT": "23f18e03dc49df91622fe2a76176497404e46ced8a715d9d2b67a7446571cca3",
    "itoa/LICENSE-APACHE": "62c7a1e35f56406896d7aa7ca52d0cc0d272ac022b5d2796e7d6905db8a3636a",
  }
}

///|
/// Predetermined declarations/imports, unchanged from the measured corpus.
fn anchor_manifest() -> String {
  (
    #|Predetermined source/API and import anchors; selected before any product outputs.
    #|typescript/src/compiler/program.ts: export function createProgram( | import * as performance from "./_namespaces/ts.performance.js";
    #|typescript/src/compiler/checker.ts: export function createTypeChecker(
    #|typescript/src/compiler/parser.ts: export function createSourceFile(
    #|typescript/src/server/session.ts: export class Session< | import * as protocol from "./protocol.js";
    #|typescript/src/server/editorServices.ts: export class ProjectService
    #|chi/chain.go: func Chain(middlewares ...func(http.Handler) http.Handler) Middlewares | type ChainHandler struct { | func (c *ChainHandler) ServeHTTP(w http.ResponseWriter, r *http.Request)
    #|chi/chi.go: package chi | import "net/http" | func NewRouter() *Mux | type Router interface { | Route(pattern string, fn func(r Router)) Router | type Routes interface { | type Middlewares []func(http.Handler) http.Handler
    #|chi/context.go: func URLParam(r *http.Request, key string) string | type Context struct { | func (x *Context) RoutePattern() string | type RouteParams struct {
    #|chi/mux.go: type Mux struct { | func NewMux() *Mux | func (mx *Mux) ServeHTTP(w http.ResponseWriter, r *http.Request) | func (mx *Mux) With(middlewares ...func(http.Handler) http.Handler) Router | func (mx *Mux) Route(pattern string, fn func(r Router)) Router
    #|chi/path_value.go: //go:build go1.22 | func setPathValue(rctx *Context, r *http.Request)
    #|chi/path_value_fallback.go: //go:build !go1.22 | func setPathValue(rctx *Context, r *http.Request)
    #|chi/tree.go: type Route struct { | type node struct { | func (n *node) InsertRoute(method methodTyp, pattern string, handler http.Handler) *node
    #|itoa/src/lib.rs: #![no_std] | mod udiv128; | use core::mem::MaybeUninit; | pub struct Buffer { | impl Buffer { | pub fn new() -> Buffer | pub fn format<I: Integer>(&mut self, i: I) -> &str | pub trait Integer: private::Sealed { | const MAX_STR_LEN: usize; | type Buffer: 'static; | fn write(self, buf: &mut Self::Buffer) -> &str; | macro_rules! impl_Integer { | impl_Integer!(i8[len = 4] as u32);
    #|itoa/src/udiv128.rs: fn u128_mulhi(x: u128, y: u128) -> u128 | #[cfg_attr(feature = "no-panic", no_panic)] | pub fn udivmod_1e19(n: u128) -> (u128, u64)
    #|
  )
}

///|
async fn checkout(h : Harness, repo : Repo) -> String {
  let work = h.work
  let root = work + "/reference/" + repo.id
  let id = repo.id
  command(
    h,
    id + "-init",
    "git",
    git_args() + ["init", "--template=" + work + "/empty-template", root],
    work,
  )
  |> ignore
  let pin = if id == "typescript" {
    let remote = command(
      h,
      id + "-remote-pin",
      "git",
      git_args() +
      ["ls-remote", repo.url, "refs/tags/v5.9.3", "refs/tags/v5.9.3^{}"],
      work,
    )
    let pins = remote.split("\n").filter(x => !x.is_empty()).collect()
    guard !pins.is_empty() else { fail("Missing TypeScript v5.9.3 pin") }
    let pin = pins[pins.length() - 1][0:40].to_owned()
    assert_eq(pin, "c63de15a992d37f0d6cec03ac7631872838602cb")
    pin
  } else {
    repo.revision
  }
  let sparse = if id == "typescript" {
    ["/src/", "/LICENSE.txt"]
  } else if id == "itoa" {
    ["/src/", "/LICENSE-MIT", "/LICENSE-APACHE"]
  } else {
    fixed_paths(id).map(path => "/" + path)
  }
  command(
    h,
    id + "-sparse",
    "git",
    git_args() + ["sparse-checkout", "set", "--no-cone"] + sparse,
    root,
  )
  |> ignore
  command(
    h,
    id + "-fetch",
    "git",
    git_args() +
    [
      "fetch",
      "--depth=1",
      "--no-tags",
      "--no-recurse-submodules",
      repo.url,
      pin,
    ],
    root,
  )
  |> ignore
  command(
    h,
    id + "-checkout",
    "git",
    git_args() + ["checkout", "--detach", pin],
    root,
  )
  |> ignore
  assert_eq(
    command(h, id + "-head", "git", git_args() + ["rev-parse", "HEAD"], root).trim(),
    pin,
  )
  save(work + "/manifest/" + id + "-pin.json", {
    "url": Json(repo.url),
    "tag": Json(repo.revision),
    "verified_head": Json(pin),
  })
  root
}

///|
async fn prepare(work : String, sources : Array[String]) -> Unit {
  // mkdir is exclusive: never overwrite a previous run or clean an arbitrary path.
  guard work.has_prefix("/") else {
    fail("Use an absolute, new workspace outside the source checkout")
  }
  @fs.mkdir(work)
  let work = @fs.realpath(work)
  for
    dir in [
      "logs", "report", "manifest", "home", "config", "cache", "tmp", "inputs", "documents",
      "reference", "empty-template",
    ] {
    @fs.mkdir(work + "/" + dir)
  }
  let h = harness(work)
  save(work + "/report/setup-started.json", {
    "phase": "setup",
    "local": Json(sources.length() == 2),
  })
  assert_eq(
    command(h, "node-version", "node", ["--version"], work).trim(),
    "v25.9.0",
  )
  let node_cli = @fs.realpath(sources[0])
  let lock = dirname(dirname(dirname(dirname(node_cli)))) + "/package-lock.json"
  @fs.write_file(
    work + "/manifest/reference-package-lock.json",
    @fs.read_file(lock),
    create_mode=CreateNew,
  )
  let fixed = pinned_hashes()
  let keys = fixed.keys().collect()
  keys.sort()
  @fs.write_file(
    work + "/manifest/offline-source-sha256.txt",
    keys.map(path => fixed[path] + "  " + path).join("\n") + "\n",
    create_mode=CreateNew,
  )
  @fs.write_file(
    work + "/manifest/anchors.txt",
    anchor_manifest(),
    create_mode=CreateNew,
  )
  if sources.length() == 4 {
    assert_eq(@fs.read_file(sources[3]).text(), anchor_manifest())
    let supplied = @fs.read_file(sources[2]).text().split("\n").collect()
    for path in keys {
      let matches = supplied.filter(line => line.has_suffix("/" + path))
      assert_eq(matches.length(), 1)
      assert_eq(matches[0][0:64], fixed[path][:])
    }
  }
  let node_package = @fs.realpath(dirname(dirname(node_cli)) + "/package.json")
  guard @json.parse(@fs.read_file(node_package).text())
    is { "version": String("1.18.1"), .. } else {
    fail("Expected installed repomix@1.18.1")
  }
  for repo in corpora() {
    let input = work + "/inputs/" + repo.id
    @fs.mkdir(input)
    let source = if sources.length() == 2 {
      if repo.id == "typescript" {
        save(work + "/manifest/typescript-pin.json", {
          "url": Json(repo.url),
          "declared_tag": Json(repo.revision),
          "verification": "local source copy; no remote HEAD claim",
        })
      }
      @fs.realpath(sources[1] + "/" + repo.id)
    } else if sources.length() == 4 && repo.id != "typescript" {
      @fs.realpath(sources[1] + "/" + repo.id)
    } else {
      checkout(h, repo)
    }
    @fs.mkdir(input + "/.git")
    let mut bytes = 0
    for path in inventory(source, repo) {
      if repo.id != "typescript" {
        assert_eq(digest(h, source + "/" + path), fixed[repo.id + "/" + path])
      }
      if path.rev_find("/") is Some(end) {
        @fs.mkdir(
          input + "/" + path[0:end].to_owned(),
          recursive=true,
          allow_exist=true,
        )
      }
      let body = @fs.read_file(source + "/" + path)
      bytes += body.binary().length()
      @fs.write_file(input + "/" + path, body, create_mode=CreateNew)
    }
    assert_eq(source_manifest(h, source, repo), source_manifest(h, input, repo))
    save(
      work + "/manifest/" + repo.id + "-source.json",
      source_manifest(h, input, repo),
    )
    assert_eq(
      bytes,
      if repo.id == "typescript" {
        35182011
      } else if repo.id == "chi" {
        50684
      } else {
        23718
      },
    )
    for (path, fragments) in anchors(h, repo.id) {
      let body = normalize(@fs.read_file(input + "/" + path).text())
      for fragment in fragments {
        assert_true(body.contains(fragment))
      }
    }
    save(work + "/manifest/" + repo.id + "-scope.json", {
      "files": Json(inventory(input, repo).length()),
      "raw_bytes": Json(bytes),
      "revision": Json(repo.revision),
    })
  }
  @fs.write_file(
    work + "/native.config.json",
    "{\"security\":{\"enableSecurityCheck\":true},\"tokenCount\":{\"encoding\":\"o200k_base\"}}\n",
    create_mode=CreateNew,
  )
  @fs.write_file(
    work + "/node.config.json",
    "{\"input\":{\"processors\":[]},\"output\":{\"git\":{\"sortByChanges\":false}},\"security\":{\"enableSecurityCheck\":true},\"tokenCount\":{\"encoding\":\"o200k_base\"}}\n",
    create_mode=CreateNew,
  )
  save(work + "/manifest/prepared.json", {
    "node_cli": Json(node_cli),
    "node_package": Json(node_package),
    "node_cli_sha256": Json(digest(h, node_cli)),
    "node_package_sha256": Json(digest(h, node_package)),
    "corpora": Json(corpora()),
    "provenance": Json(
      if sources.length() == 1 {
        "All three public HTTPS Git pins and HEAD verified; twelve embedded Go/Rust hashes and all predetermined anchors checked"
      } else if sources.length() == 2 {
        "Local copies; TypeScript revision declared, not remotely verified; twelve embedded Go/Rust hashes and all predetermined anchors checked"
      } else {
        "TypeScript public HTTPS Git pin/HEAD verified; legacy offline Go/Rust inputs checked against the same twelve embedded hashes and anchors"
      },
    ),
    "node_version": "25.9.0",
    "repomix_version": "1.18.1",
    "cache": "new HOME/XDG/TMP and token cache; retained after warmup; normal Node worker pool",
  })
  save(work + "/report/setup-complete.json", { "phase": "setup-complete" })
  println("Prepared: " + work)
}

///|
async fn fresh(work : String, prepared : String) -> Unit {
  guard work.has_prefix("/") else { fail("Absolute new workspace required") }
  @fs.mkdir(work)
  for
    dir in [
      "logs", "report", "manifest", "home", "config", "cache", "tmp", "inputs", "documents",
      "reference", "empty-template",
    ] {
    @fs.mkdir(work + "/" + dir)
  }
  let h = harness(work)
  for
    file in [
      "prepared.json", "typescript-source.json", "typescript-scope.json", "typescript-pin.json",
      "chi-source.json", "chi-scope.json", "itoa-source.json", "itoa-scope.json",
      "reference-package-lock.json", "offline-source-sha256.txt", "anchors.txt",
    ] {
    @fs.write_file(
      work + "/manifest/" + file,
      @fs.read_file(prepared + "/manifest/" + file),
      create_mode=CreateNew,
    )
  }
  for file in ["chi-pin.json", "itoa-pin.json"] {
    if @fs.exists(prepared + "/manifest/" + file) {
      @fs.write_file(
        work + "/manifest/" + file,
        @fs.read_file(prepared + "/manifest/" + file),
        create_mode=CreateNew,
      )
    }
  }
  for file in ["native.config.json", "node.config.json"] {
    @fs.write_file(
      work + "/" + file,
      @fs.read_file(prepared + "/" + file),
      create_mode=CreateNew,
    )
  }
  for repo in corpora() {
    let input = work + "/inputs/" + repo.id
    @fs.mkdir(input)
    @fs.mkdir(input + "/.git")
    for path in inventory(prepared + "/inputs/" + repo.id, repo) {
      if path.rev_find("/") is Some(end) {
        @fs.mkdir(
          input + "/" + path[0:end].to_owned(),
          recursive=true,
          allow_exist=true,
        )
      }
      @fs.write_file(
        input + "/" + path,
        @fs.read_file(prepared + "/inputs/" + repo.id + "/" + path),
        create_mode=CreateNew,
      )
    }
    assert_eq(
      source_manifest(h, input, repo),
      @json.parse(
        @fs.read_file(work + "/manifest/" + repo.id + "-source.json").text(),
      ),
    )
  }
  save(work + "/manifest/fresh-from.json", {
    "verified_prepared": Json(prepared),
    "cache": "new empty HOME/XDG/TMP; no prior token cache copied",
  })
  println("Fresh verified workspace: " + work)
}

///|
fn files(document : String) -> Map[String, String] raise {
  guard @json.parse(document) is { "files": Object(entries), .. } else {
    fail("Missing JSON files map")
  }
  let result : Map[String, String] = Map([])
  for path, value in entries {
    guard value is String(body) else { fail("Non-string file body") }
    result[path] = body
  }
  result
}

///|
fn paths(bodies : Map[String, String]) -> Array[String] {
  let result = bodies.keys().collect()
  result.sort()
  result
}

///|
/// Independent sampled API obligations. Node compression has different retention semantics.
async fn anchors(h : Harness, repo : String) -> Array[(String, Array[String])] {
  let result : Array[(String, Array[String])] = []
  for line in @fs.read_file(h.work + "/manifest/anchors.txt").text().split("\n") {
    if line.has_prefix(repo + "/") && line.find(": ") is Some(end) {
      result.push(
        (
          line[repo.length() + 1:end].to_owned(),
          line[end + 2:].split(" | ").map(x => x.to_owned()).collect(),
        ),
      )
    }
  }
  guard !result.is_empty() else { fail("Missing independent anchors: " + repo) }
  result
}

///|
fn normalize(text : String) -> String {
  text.split("\n").map(line => line.trim().to_owned()).collect().join(" ")
}

///|
fn cli(
  h : Harness,
  repo : Repo,
  implementation : String,
  native : String,
  node_cli : String,
  vocabulary : String,
  compressed : Bool,
  output : String,
) -> (String, Array[String]) {
  let args = [
    h.work + "/inputs/" + repo.id,
    "--config",
    h.work + "/" + implementation + ".config.json",
    "--include",
    if repo.id == "typescript" {
      "src/**,LICENSE.txt"
    } else if repo.id == "chi" {
      "*.go,LICENSE"
    } else {
      "src/**,LICENSE-MIT,LICENSE-APACHE"
    },
    "--style",
    "json",
    "--parsable-style",
    "--top-files-len",
    "0",
    "--quiet",
    "-o",
    output,
  ]
  if compressed {
    args.push("--compress")
  }
  if implementation == "node" {
    ("node", [node_cli] + args)
  } else {
    (
      native,
      args +
      ["--tokenizer-path", vocabulary, "--report-json"] +
      (if compressed { ["--full-metadata"] } else { [] }),
    )
  }
}

///|
fn time_fields(
  stderr : String,
  linux : Bool,
) -> (Double, Double, Double, Double) raise {
  if linux {
    for line in stderr.split("\n") {
      if line.has_prefix("BENCH_TIME ") {
        let fields = line.split(" ").collect()
        guard fields.length() == 5 else { fail("Malformed GNU time metrics") }
        return (
          @string.parse_double(fields[1]),
          @string.parse_double(fields[2]),
          @string.parse_double(fields[3]),
          @string.parse_double(fields[4]) * 1024.0,
        )
      }
    }
    fail("Missing GNU time metrics")
  } else {
    let values : Map[String, Double] = Map([])
    for line in stderr.split("\n") {
      let line = line.trim()
      for name in ["real", "user", "sys"] {
        if line.has_prefix(name + " ") {
          values[name] = @string.parse_double(line[name.length():].trim())
        }
      }
      if line.find("  maximum resident set size") is Some(end) {
        values["rss"] = @string.parse_double(line[0:end].trim())
      }
    }
    guard values.length() == 4 else { fail("Missing macOS time metrics") }
    (values["real"], values["user"], values["sys"], values["rss"])
  }
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(result) else {
    fail("Missing report field: " + key)
  }
  result
}

///|
fn decimal(value : Json) -> Int64 raise {
  guard value is String(text) &&
    !text.is_empty() &&
    text.iter().all(c => c >= '0' && c <= '9') else {
    fail("Expected unsigned decimal report string")
  }
  @string.parse_int64(text)
}

///|
/// The CLI emits its schema-1 report on stderr, alongside independently parsed time lines.
async fn validate_native_report(
  h : Harness,
  repo : Repo,
  id : String,
  document : Bytes,
) -> Json {
  let stderr = @fs.read_file(h.work + "/logs/" + id + ".stderr").text()
  let json_lines = stderr
    .split("\n")
    .filter(line => line.has_prefix("{"))
    .collect()
  assert_eq(json_lines.length(), 1)
  let report = @json.parse(json_lines[0])
  let tokens = field(report, "tokens")
  let count = decimal(field(tokens, "total"))
  assert_true(count > 0L)
  let bodies = files(@utf8.decode(document, ignore_bom=false))
  let expected = inventory(h.work + "/inputs/" + repo.id, repo).filter(path => {
    !(repo.id == "typescript" &&
    path == "src/testRunner/unittests/services/colorization.ts")
  })
  assert_eq(paths(bodies), expected)
  assert_eq(report, {
    "schemaVersion": 1,
    "status": "ok",
    "operation": "pack",
    "publication": "committed",
    "exitCode": 0,
    "style": "json",
    "security": {
      "enabled": true,
      "status": Json(
        if repo.id == "typescript" {
          "excluded"
        } else {
          "passed"
        },
      ),
      "findings": Json(if repo.id == "typescript" { 1 } else { 0 }),
    },
    "counts": {
      "acceptedFiles": Json(bodies.length()),
      "skippedEntries": Json(if repo.id == "typescript" { 2 } else { 1 }),
    },
    "output": { "kind": "file", "documents": 1 },
    "limits": { "maxFiles": 20000, "maxTotalSize": "209715200" },
    "tokens": {
      "documents": Json(count.to_string()),
      "index": "0",
      "total": Json(count.to_string()),
      "limit": Json::null(),
      "exceeded": false,
    },
    "bytes": {
      "documents": Json(document.length().to_string()),
      "index": "0",
      "total": Json(document.length().to_string()),
    },
  })
  let safe_config = @json.parse(
    @fs.read_file(h.work + "/native.config.json").text(),
  )
  assert_eq(
    field(field(safe_config, "security"), "enableSecurityCheck"),
    Json(true),
  )
  assert_eq(
    field(field(safe_config, "tokenCount"), "encoding"),
    Json("o200k_base"),
  )
  let timing = stderr
    .split("\n")
    .filter(line => !line.has_prefix("{"))
    .collect()
    .join("\n")
  let (wall, user, sys, rss) = time_fields(timing, h.linux)
  assert_true(wall > 0.0 && rss > 0.0)
  let sha = digest(h, h.work + "/documents/" + id + ".json")
  if @fs.exists(h.work + "/report/" + id + "-sample.json") {
    let sample = @json.parse(
      @fs.read_file(h.work + "/report/" + id + "-sample.json").text(),
    )
    assert_eq(field(sample, "output_sha256"), Json(sha))
    assert_eq(field(sample, "output_bytes"), Json(document.length()))
    assert_eq(field(sample, "wall_seconds"), Json(wall))
    assert_eq(field(sample, "user_seconds"), Json(user))
    assert_eq(field(sample, "sys_seconds"), Json(sys))
    assert_eq(field(sample, "rss_bytes"), Json(rss))
  }
  {
    "id": Json(id),
    "report": report,
    "output_sha256": Json(sha),
    "accepted_paths": Json(paths(bodies)),
    "time": {
      "wall_seconds": Json(wall),
      "user_seconds": Json(user),
      "sys_seconds": Json(sys),
      "rss_bytes": Json(rss),
    },
  }
}

///|
async fn audit_native_reports(h : Harness) -> Int32 {
  let checked : Array[Json] = []
  let unreported : Array[Json] = []
  let counts_by_sha : Map[String, Json] = Map([])
  for repo in corpora() {
    for mode in ["raw", "compressed"] {
      for round in 0..<=5 {
        let id = repo.id + "-" + mode + "-native-" + round.to_string()
        let stem = h.work + "/logs/" + id
        if !@fs.exists(stem + ".command.json") {
          continue
        }
        let command = @json.parse(@fs.read_file(stem + ".command.json").text())
        guard field(command, "argv") is Array(args) else {
          fail("Missing retained argv")
        }
        if !args.contains(Json("--report-json")) {
          assert_true(
            !@fs.read_file(stem + ".stderr")
            .text()
            .contains("\"schemaVersion\""),
          )
          unreported.push({
            "id": Json(id),
            "reason": "original argv did not request --report-json; no schema-1 report present",
          })
          continue
        }
        assert_true(
          args.contains(Json("--quiet")) &&
          args.contains(Json("--tokenizer-path")),
        )
        assert_eq(args.contains(Json("--full-metadata")), mode == "compressed")
        assert_eq(@json.parse(@fs.read_file(stem + ".exit.json").text()), {
          "exit": 0,
        })
        let row = validate_native_report(
          h,
          repo,
          id,
          @fs.read_file(h.work + "/documents/" + id + ".json").binary(),
        )
        let sha = match field(row, "output_sha256") {
          String(s) => s
          _ => fail("Invalid digest")
        }
        let tokens = field(field(row, "report"), "tokens")
        if counts_by_sha.get(sha) is Some(previous) {
          assert_eq(tokens, previous)
        } else {
          counts_by_sha[sha] = tokens
        }
        checked.push(row)
      }
    }
  }
  // Ensure every timed native stderr with --report-json was covered, not just expected successes.
  let mut observed = 0
  for entry in @fs.readdir(h.work + "/logs") {
    if entry.has_suffix(".command.json") {
      let j = @json.parse(@fs.read_file(h.work + "/logs/" + entry).text())
      if field(j, "program") == Json("/usr/bin/time") &&
        field(j, "argv") is Array(args) &&
        args.contains(Json("--report-json")) {
        observed += 1
      }
    }
  }
  assert_eq(observed, checked.length())
  save(h.work + "/report/native-stderr-audit.json", {
    "schema": 1,
    "product_invocations": 0,
    "reports_validated": Json(checked.length()),
    "rows": Json(checked),
    "no_report_requested": Json(unreported),
    "checks": "schema/status/operation/publication/exit/style, security enabled/status/findings, accepted paths/count and skippedEntries, actual output bytes, documents/index/total arithmetic, no token limit/exceedance, maxFiles/maxTotalSize, safe JSON o200k, exact producer token counts stable for identical output SHA, separate time parsing vs retained samples",
    "token_count_provenance": "Retained native exact whole-document o200k counts; this offline audit checks declared totals and stability, not a new independent tokenization run",
  })
  println(
    "Offline stderr reports verified: " +
    checked.length().to_string() +
    "; product invocations=0",
  )
  checked.length()
}

///|
async fn verify_prepared(work : String, prior : String) -> Unit {
  let h = harness(@fs.realpath(work))
  assert_eq(
    @fs.read_file(work + "/manifest/anchors.txt").text(),
    anchor_manifest(),
  )
  assert_eq(
    @fs.read_file(prior + "/manifest/anchors.txt").text(),
    anchor_manifest(),
  )
  let fixed = pinned_hashes()
  assert_eq(fixed.length(), 12)
  for repo in corpora() {
    let actual = source_manifest(h, work + "/inputs/" + repo.id, repo)
    assert_eq(
      actual,
      @json.parse(
        @fs.read_file(prior + "/manifest/" + repo.id + "-source.json").text(),
      ),
    )
    assert_eq(
      actual,
      @json.parse(
        @fs.read_file(work + "/manifest/" + repo.id + "-source.json").text(),
      ),
    )
    for path in inventory(work + "/inputs/" + repo.id, repo) {
      if repo.id != "typescript" {
        assert_eq(
          digest(h, work + "/inputs/" + repo.id + "/" + path),
          fixed[repo.id + "/" + path],
        )
      }
    }
  }
  save(work + "/report/prepared-verified.json", {
    "product_invocations": 0,
    "source_files": 748,
    "fixed_go_rust_hashes": 12,
    "anchors_identical": true,
    "all_source_sha_equal_prior": true,
    "public_network_setup_executed": false,
  })
  println(
    "Offline preparation verified: 748 identical source/license hashes, 12 pinned Go/Rust hashes, unchanged anchors; no product invocation",
  )
}

///|
async fn measure(
  h : Harness,
  repo : Repo,
  implementation : String,
  native : String,
  node_cli : String,
  vocabulary : String,
  compressed : Bool,
  round : Int32,
  reuse~ : Bool = false,
) -> Sample {
  let mode = if compressed { "compressed" } else { "raw" }
  let id = repo.id + "-" + mode + "-" + implementation + "-" + round.to_string()
  let output = h.work + "/documents/" + id + ".json"
  let (program, args) = cli(
    h, repo, implementation, native, node_cli, vocabulary, compressed, output,
  )
  let timed = (if h.linux { ["-f", "BENCH_TIME %e %U %S %M"] } else { ["-lp"] }) +
    [program] +
    args
  if reuse && @fs.exists(h.work + "/logs/" + id + ".command.json") {
    assert_eq(
      @json.parse(
        @fs.read_file(h.work + "/logs/" + id + ".command.json").text(),
      ),
      { "program": "/usr/bin/time", "argv": Json(timed), "cwd": Json(h.work) },
    )
    assert_eq(
      @json.parse(@fs.read_file(h.work + "/logs/" + id + ".exit.json").text()),
      { "exit": 0 },
    )
    println("Reusing exact retained exit=0 receipt; no spawn: " + id)
  } else {
    command(h, id, "/usr/bin/time", timed, h.work) |> ignore
  }
  let (wall_seconds, user_seconds, sys_seconds, rss_bytes) = time_fields(
    @fs.read_file(h.work + "/logs/" + id + ".stderr").text(),
    h.linux,
  )
  guard wall_seconds > 0.0 && rss_bytes > 0.0 else {
    fail("Unusable time/RSS metrics: " + id)
  }
  let document = @fs.read_file(output)
  if implementation == "native" {
    validate_native_report(h, repo, id, document.binary()) |> ignore
  }
  let bodies = files(document.text())
  let root = h.work + "/inputs/" + repo.id
  let source_paths = inventory(root, repo)
  let expected = source_paths.filter(path => {
    !(implementation == "native" &&
    repo.id == "typescript" &&
    path == "src/testRunner/unittests/services/colorization.ts")
  })
  save(h.work + "/report/" + id + "-selection.json", {
    "source": Json(source_paths),
    "accepted": Json(paths(bodies)),
    "missing": Json(source_paths.filter(path => !bodies.contains(path))),
    "native_known_exclusion": "colorization.ts: read-only explain confirms security/credential-assignment, source unmodified",
  })
  assert_eq(paths(bodies), expected)
  if !compressed {
    for path, body in bodies {
      let source = @fs.read_file(root + "/" + path).text()
      let expected_body = if implementation == "native" {
        native_source(source)
      } else {
        native_source(source).trim().to_owned()
      }
      guard body == expected_body else {
        fail(
          "Raw source mismatch: " +
          id +
          " " +
          path +
          " body/source UTF16=" +
          body.length().to_string() +
          "/" +
          expected_body.length().to_string(),
        )
      }
    }
  }
  let obligations : Array[Json] = []
  let mut api_ok = true
  for (path, fragments) in anchors(h, repo.id) {
    for fragment in fragments {
      let present = normalize(bodies[path]).contains(fragment)
      obligations.push({
        "path": Json(path),
        "fragment": Json(fragment),
        "present": Json(present),
      })
      api_ok = api_ok && present
    }
  }
  save(h.work + "/report/" + id + "-contract.json", {
    "paths": Json(paths(bodies)),
    "output_utf16_units": Json(document.text().length()),
    "node_parallel_chunk_threshold_exceeded": Json(
      implementation == "node" && document.text().length() > 1000000,
    ),
    "metadata": match @json.parse(document.text()) {
      { "metadata": m, .. } => m
      _ => Json::null()
    },
    "api_anchors": Json(obligations),
    "api_required": Json(implementation == "native" || !compressed),
    "scanner_enabled_in_safe_json": true,
  })
  guard api_ok || (implementation == "node" && compressed) else {
    fail("API preservation failed: " + id)
  }
  let sample : Sample = {
    repo: repo.id,
    mode,
    implementation,
    round,
    wall_seconds,
    user_seconds,
    sys_seconds,
    rss_bytes,
    output_sha256: digest(h, output),
    output_bytes: document.binary().length(),
    api_ok,
  }
  save(h.work + "/report/" + id + "-sample.json", ToJson::to_json(sample))
  println(
    id +
    " wall=" +
    wall_seconds.to_string() +
    " rss_bytes=" +
    rss_bytes.to_string(),
  )
  sample
}

///|
/// Validate retained measured full metadata; never rerun the product for validation.
async fn validate_ranges(
  h : Harness,
  repo : Repo,
  native : String,
  node_cli : String,
  vocabulary : String,
) -> Unit {
  ignore((native, node_cli, vocabulary))
  for round in 0..<=5 {
    save(
      h.work + "/report/" + repo.id + "-ranges-" + round.to_string() + ".json",
      check_ranges(h, repo, round~),
    )
  }
}

///|
async fn check_ranges(h : Harness, repo : Repo, round~ : Int32 = 0) -> Json {
  let text = @fs.read_file(
    h.work +
    "/documents/" +
    repo.id +
    "-compressed-native-" +
    round.to_string() +
    ".json",
  ).text()
  let bodies = files(text)
  guard @json.parse(text)
    is { "metadata": { "compression": Array(records), .. }, .. } else {
    fail("Missing full compression records")
  }
  let seen : Map[String, Json] = Map([])
  for record in records {
    guard record
      is {
        "path": String(path),
        "ranges": Array(ranges),
        "applied": applied_json,
        "language": language,
        "reason": reason,
        "originalTokens": Number(original_tokens, ..),
        "outputTokens": Number(output_tokens, ..),
        ..
      } else {
      fail("Incomplete compression record")
    }
    let applied = match applied_json {
      True => true
      False => false
      _ => fail("Non-boolean applied field")
    }
    let known_reason = match reason {
      Null
      | String("not-fewer-tokens")
      | String("not-smaller")
      | String("unsupported")
      | String("parse-error")
      | String("timeout")
      | String("too-large")
      | String("too-deep")
      | String("resource-limit")
      | String("parser-unavailable") => true
      _ => false
    }
    guard known_reason else {
      fail(
        "Unexpected compression fallback: " + path + " " + reason.stringify(),
      )
    }
    guard !seen.contains(path) && bodies.contains(path) else {
      fail("Duplicate/unknown compression path")
    }
    guard language is Null || language is String(_) else {
      fail("Invalid compression language")
    }
    guard !applied ||
      (
        reason is Null &&
        language is String(_) &&
        !ranges.is_empty() &&
        !bodies[path].trim().is_empty()
      ) else {
      fail("Missing compressed body/ranges/language: " + path)
    }
    let source = native_source(
      @fs.read_file(h.work + "/inputs/" + repo.id + "/" + path).text(),
    )
    let lines = source.split("\n").collect()
    let mut previous = 0
    for range in ranges {
      guard range is [Number(start, ..), Number(end, ..)] &&
        start == start.floor() &&
        end == end.floor() &&
        start > previous.to_double() &&
        end >= start &&
        end <= lines.length().to_double() else {
        fail("Invalid source line ranges: " + path)
      }
      previous = end.to_int()
    }
    guard original_tokens > 0.0 &&
      output_tokens > 0.0 &&
      (!applied || output_tokens < original_tokens) else {
      fail("Invalid compression token counts")
    }
    if !applied {
      assert_true(ranges.is_empty())
      assert_eq(bodies[path], source)
    }
    for (anchor_path, fragments) in anchors(h, repo.id) {
      if anchor_path != path {
        continue
      }
      for fragment in fragments {
        let mut found = false
        for index, line in lines {
          if line.contains(fragment) {
            found = true
            if !applied {
              continue
            } // Raw fallback was already checked byte-for-byte.
            assert_true(
              ranges
              .iter()
              .any(range => {
                match range {
                  [Number(start, ..), Number(end, ..)] =>
                    start <= (index + 1).to_double() &&
                    (index + 1).to_double() <= end
                  _ => false
                }
              }),
            )
          }
        }
        guard found else { fail("Source API anchor missing: " + fragment) }
      }
    }
    seen[path] = record
  }
  assert_eq(seen.length(), bodies.length())
  Json(records)
}

///|
fn median(values : Array[Double]) -> Double {
  let sorted = values.copy()
  sorted.sort()
  sorted[sorted.length() / 2]
}

///|
fn stats(values : Array[Double]) -> Json {
  let med = median(values)
  let sorted = values.copy()
  sorted.sort()
  {
    "median": Json(med),
    "min": Json(sorted[0]),
    "max": Json(sorted[sorted.length() - 1]),
    "mad": Json(
      median(values.map(x => if x < med { med - x } else { x - med })),
    ),
    "samples": Json(values),
  }
}

///|
async fn run(
  work : String,
  native : String,
  vocabulary : String,
  reuse_receipts~ : Bool = false,
) -> Unit {
  let work = @fs.realpath(work)
  if !reuse_receipts {
    @fs.mkdir(work + "/run")
  }
  let h = harness(work)
  let native = @fs.realpath(native)
  let vocabulary = @fs.realpath(vocabulary)
  assert_eq(
    digest(h, native),
    "67da22e745ca556a0e37bb9ea86d1813371d4951c7f504a431e016f3d07327b9",
  )
  assert_eq(
    digest(h, vocabulary),
    "446a9538cb6c348e3516120d7c08b09f57c36495e2acfffe59a5bf8b0cfb1a2d",
  )
  guard @json.parse(@fs.read_file(work + "/manifest/prepared.json").text())
    is {
      "node_cli": String(node_cli),
      "node_package": String(node_package),
      "node_cli_sha256": String(node_sha),
      "node_package_sha256": String(package_sha),
      ..
    } else {
    fail("Workspace preparation incomplete")
  }
  if !reuse_receipts {
    assert_eq(
      command(h, "run-node-version", "node", ["--version"], work).trim(),
      "v25.9.0",
    )
  }
  assert_eq(digest(h, node_cli), node_sha)
  assert_eq(digest(h, node_package), package_sha)
  let identities : Map[String, String] = Map([])
  for
    path in [
      native,
      vocabulary,
      @fs.realpath(dirname(vocabulary) + "/tokenizer-unicode-16.0.0.txt"),
      node_cli,
      node_package,
      @fs.realpath("scripts/benchmark-workloads.mbtx"),
      work + "/native.config.json",
      work + "/node.config.json",
    ] {
    identities[path] = digest(h, path)
  }
  if reuse_receipts {
    save(work + "/manifest/resume-" + @env.now().to_string() + ".json", {
      "script_sha256": Json(
        digest(h, @fs.realpath("scripts/benchmark-workloads.mbtx")),
      ),
      "reason": "offline guard corrected for documented one-BOM stripping; exact successful receipt reused, no retry or sample removal",
    })
  }
  if !reuse_receipts {
    save(work + "/manifest/run.json", {
      "identities_sha256": Json(identities),
      "rounds": 5,
      "warmups": 1,
      "order": "alternate native/node first each measured round; fresh processes",
      "rss": Json(
        if h.linux {
          "GNU time %M KiB converted to bytes; process maximum, not worker sum"
        } else {
          "macOS time -lp maximum resident set size bytes; not worker sum"
        },
      ),
      "wall": "time real/elapsed seconds, not user+sys CPU",
      "statistics": "all five measured samples; median/min/max/MAD; warmup excluded",
      "node_compression": "API omissions recorded, not asserted equivalent to Native",
      "range_guard": "native compressed timed argv includes full-metadata; all six retained outputs checked outside timing: complete records, ordered bounded ranges, sampled API source-line coverage; parse/time/size fallback retained, never omitted",
    })
    command(h, "platform", "/usr/bin/uname", ["-a"], work) |> ignore
    command(h, "native-version", native, ["--version"], work) |> ignore
    command(
      h,
      "source-revision",
      "git",
      git_args() + ["rev-parse", "HEAD"],
      @fs.realpath("."),
    )
    |> ignore
    command(
      h,
      "source-status",
      "git",
      git_args() + ["status", "--short"],
      @fs.realpath("."),
    )
    |> ignore
  }
  let rows : Array[Sample] = []
  let summaries : Array[Json] = []
  let unfavorable : Array[String] = []
  let markdown = StringBuilder()
  markdown.write_string(
    "# Native / Node benchmark\n\nFive fresh-process rounds after one excluded warmup; normal caches retained.\nWall and RSS are medians. Shared-runner results are descriptive, not a performance gate.\nNode compressed API retention differs; see per-round contracts.\n\n| Case | Native wall s | Node wall s | Node/native wall | Wall | Native RSS bytes | Node RSS bytes | RSS |\n| --- | ---: | ---: | ---: | --- | ---: | ---: | --- |\n",
  )
  for repo in corpora() {
    let root = work + "/inputs/" + repo.id
    let original = @json.parse(
      @fs.read_file(work + "/manifest/" + repo.id + "-source.json").text(),
    )
    assert_eq(source_manifest(h, root, repo), original)
    for compressed in [false, true] {
      let mode = if compressed { "compressed" } else { "raw" }
      let warmups : Map[String, String] = Map([])
      for implementation in ["native", "node"] {
        let sample = measure(
          h,
          repo,
          implementation,
          native,
          node_cli,
          vocabulary,
          compressed,
          0,
          reuse=reuse_receipts,
        )
        warmups[implementation] = sample.output_sha256
      }
      for round in 1..<=5 {
        for
          implementation in (if round % 2 == 1 {
            ["native", "node"]
          } else {
            ["node", "native"]
          }) {
          let sample = measure(
            h,
            repo,
            implementation,
            native,
            node_cli,
            vocabulary,
            compressed,
            round,
            reuse=reuse_receipts,
          )
          save(
            work +
            "/report/" +
            repo.id +
            "-" +
            mode +
            "-" +
            implementation +
            "-" +
            round.to_string() +
            "-stability.json",
            {
              "matches_warmup": Json(
                sample.output_sha256 == warmups[implementation],
              ),
            },
          )
          rows.push(sample)
        }
      }
      if compressed {
        validate_ranges(h, repo, native, node_cli, vocabulary)
      }
      let native_rows = rows.filter(r => {
        r.repo == repo.id && r.mode == mode && r.implementation == "native"
      })
      let node_rows = rows.filter(r => {
        r.repo == repo.id && r.mode == mode && r.implementation == "node"
      })
      assert_eq(native_rows.length(), 5)
      assert_eq(node_rows.length(), 5)
      let native_wall = median(native_rows.map(r => r.wall_seconds))
      let node_wall = median(node_rows.map(r => r.wall_seconds))
      let native_rss = median(native_rows.map(r => r.rss_bytes))
      let node_rss = median(node_rows.map(r => r.rss_bytes))
      let wall = if native_wall < node_wall { "better" } else { "not-better" }
      let rss = if native_rss < node_rss { "better" } else { "not-better" }
      let case = repo.id + "-" + mode
      if wall == "not-better" || rss == "not-better" {
        unfavorable.push(case)
      }
      for
        (implementation, group) in [
          ("native", native_rows),
          ("node", node_rows),
        ] {
        summaries.push({
          "case": Json(case),
          "implementation": Json(implementation),
          "wall_seconds": stats(group.map(r => r.wall_seconds)),
          "user_seconds": stats(group.map(r => r.user_seconds)),
          "sys_seconds": stats(group.map(r => r.sys_seconds)),
          "rss_bytes": stats(group.map(r => r.rss_bytes)),
          "api_ok": Json(group.iter().all(r => r.api_ok)),
        })
      }
      save(work + "/report/" + case + "-comparison.json", {
        "wall": Json(wall),
        "rss": Json(rss),
        "node_over_native_wall": Json(node_wall / native_wall),
        "native_over_node_rss": Json(native_rss / node_rss),
      })
      markdown.write_string(
        "| " +
        case +
        " | " +
        native_wall.to_string() +
        " | " +
        node_wall.to_string() +
        " | " +
        (node_wall / native_wall).to_string() +
        " | " +
        wall +
        " | " +
        native_rss.to_string() +
        " | " +
        node_rss.to_string() +
        " | " +
        rss +
        " |\n",
      )
    }
    assert_eq(source_manifest(h, root, repo), original)
  }
  for path, sha in identities {
    assert_eq(digest(h, path), sha)
  }
  save(work + "/report/rounds.json", Json(rows))
  save(work + "/report/summary.json", {
    "statistics": Json(summaries),
    "unfavorable_cases": Json(unfavorable),
  })
  markdown.write_string(
    "\nUnfavorable cases (wall or RSS not better): " +
    (if unfavorable.is_empty() { "none" } else { unfavorable.join(", ") }) +
    ".\n\nAll samples, including slow samples, are retained in summary.json and per-round logs.\nA green correctness run does not imply Native is faster on every platform.\n",
  )
  @fs.write_file(
    work + "/report/REPORT.md",
    markdown.to_string(),
    create_mode=CreateNew,
  )
  save(work + "/report/complete.json", {
    "phase": "complete",
    "measured_processes": 60,
    "warmup_processes": 12,
    "untimed_range_checks_of_retained_documents": 18,
    "extra_product_runs": 0,
    "identities_and_inputs_unchanged": true,
  })
  println("Report: " + work + "/report/REPORT.md")
}

///|
async fn verify(work : String) -> Unit {
  // Offline contract recheck of retained documents; never reruns or selects timing samples.
  assert_eq(
    time_fields("diagnostic\nBENCH_TIME 0.12 0.20 0.03 12345\n", true),
    (0.12, 0.20, 0.03, 12641280.0),
  )
  assert_eq(
    time_fields(
      "real 0.12\nuser 0.20\nsys 0.03\n 12345  maximum resident set size\n", false,
    ),
    (0.12, 0.20, 0.03, 12345.0),
  )
  assert_eq(median([9.0, 1.0, 5.0, 3.0, 7.0]), 5.0)
  let h = harness(@fs.realpath(work))
  for repo in corpora() {
    check_ranges(h, repo) |> ignore
  }
  println("Offline range/body/API and GNU/macOS time parser checks passed")
}

///|
async fn main {
  let args = @env.args()
  match args[1:] {
    ["prepare", work, node_cli] => prepare(work, [node_cli])
    ["local", work, node_cli, source_root] =>
      prepare(work, [node_cli, source_root])
    ["prepare", work, node_cli, upstream, hashes, anchor_manifest] =>
      prepare(work, [node_cli, upstream, hashes, anchor_manifest])
    ["fresh", work, prepared] => fresh(work, prepared)
    ["run", work, native, vocabulary] => run(work, native, vocabulary)
    ["resume", work, native, vocabulary] =>
      run(work, native, vocabulary, reuse_receipts=true)
    ["verify", work] => {
      verify(work)
      assert_eq(audit_native_reports(harness(@fs.realpath(work))), 36)
    }
    ["audit-reports", work] =>
      audit_native_reports(harness(@fs.realpath(work))) |> ignore
    ["verify-prepared", work, prior] => verify_prepared(work, prior)
    ["diagnose", work, native, vocabulary] => {
      let h = harness(work)
      let (program, args) = cli(
        h,
        corpora()[0],
        "native",
        native,
        "",
        vocabulary,
        false,
        work + "/diagnostic-output.json",
      )
      let diagnostic = args[0:args.length() - 5].to_owned() +
        [
          "--tokenizer-path", vocabulary, "--explain-path", "src/testRunner/unittests/services/colorization.ts",
        ]
      println(command(h, "diagnose-colorization-2", program, diagnostic, work))
    }
    _ =>
      fail(
        "Usage: benchmark-workloads.mbtx prepare NEW_WORKSPACE REFERENCE_CLI | local NEW_WORKSPACE REFERENCE_CLI SOURCE_ROOT | prepare NEW_WORKSPACE REFERENCE_CLI GO_RUST_ROOT HASH_MANIFEST ANCHOR_MANIFEST (legacy) | run WORKSPACE FROZEN_NATIVE VOCABULARY | verify WORKSPACE | audit-reports WORKSPACE | verify-prepared NEW_PREPARED PRIOR_PREPARED (offline; run from product checkout)",
      )
  }
}
