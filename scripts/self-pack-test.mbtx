///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn packed_tokens(report : String) -> Int32 raise {
  for word in report.split(" "); previous = "" {
    if word == "tokens" {
      break @string.parse_int(previous)
    }
    continue word.to_owned()
  } nobreak {
    fail("Missing complete document token count")
  }
}

///|
async fn moonbit_self_pack(
  binary : String,
  common : Array[String],
  repo : String,
  output : String,
) -> Unit {
  let raw_path = output + "/moonbit-raw.json"
  let compressed_path = output + "/moonbit-compressed.json"
  let selected = common +
    [
      "--style", "json", "--include", "src/**/*.{mbt,mbti}", "--top-files-len", "0",
    ]
  let (raw_code, _, raw_error) = @process.collect_output(
    binary,
    selected + ["-o", raw_path],
    cwd=repo,
  )
  @fs.write_file(output + "/moonbit-raw.log", raw_error, create_mode=CreateNew)
  assert_eq(raw_code, 0, msg=raw_error.text())
  let (code, _, error) = @process.collect_output(
    binary,
    selected + ["--compress", "--full-metadata", "-o", compressed_path],
    cwd=repo,
  )
  @fs.write_file(
    output + "/moonbit-compressed.log",
    error,
    create_mode=CreateNew,
  )
  assert_eq(code, 0, msg=error.text())
  guard @json.parse(@fs.read_file(raw_path).text())
    is { "files": Object(original), .. } else {
    fail("Missing raw MoonBit files")
  }
  guard @json.parse(@fs.read_file(compressed_path).text())
    is {
      "files": Object(files),
      "metadata": { "compression": Array(records), .. },
      ..
    } else {
    fail("Missing complete MoonBit records")
  }
  assert_true(!files.is_empty())
  assert_eq(files.length(), original.length())
  assert_eq(records.length(), files.length())
  for (path, value) in files {
    assert_true(path.has_suffix(".mbt") || path.has_suffix(".mbti"), msg=path)
    guard original.get(path) is Some(String(source)) else {
      fail("Different accepted MoonBit set: " + path)
    }
    assert_eq(source, @fs.read_file(repo + "/" + path).text(), msg=path)
    if path.has_suffix(".mbti") {
      assert_eq(value, Json(source), msg=path)
    }
  }
  assert_false(files.contains("src/security/scan_test.mbt"))
  let mut applied_count = 0
  let mut interface_count = 0
  for record in records {
    guard record
      is {
        "path": String(path),
        "language": String("moonbit"),
        "applied": applied,
        "reason": reason,
        "ranges": Array(ranges),
        "originalTokens": Number(before, ..),
        "outputTokens": Number(after, ..),
        ..
      } else {
      fail("Invalid MoonBit compression record")
    }
    guard original.get(path) is Some(String(source)) &&
      files.get(path) is Some(String(text)) else {
      fail("MoonBit record without body")
    }
    if path.has_suffix(".mbti") {
      interface_count += 1
    }
    match applied {
      True => {
        applied_count += 1
        assert_eq(reason, Json::null())
        assert_true(after < before && !ranges.is_empty(), msg=path)
        let lines : Array[StringView] = source.split("\n").collect()
        let mut previous = 0.0
        for range in ranges {
          guard range is [Number(start, ..), Number(end, ..)] else {
            fail("Invalid original line range")
          }
          assert_true(
            start > previous &&
            end >= start &&
            end <= lines.length().to_double(),
            msg=path,
          )
          previous = end
        }
      }
      False => {
        assert_eq(reason, Json("not-smaller"), msg=path)
        assert_eq(text, source, msg=path)
        assert_true(ranges.is_empty(), msg=path)
      }
      _ => fail("Invalid applied flag")
    }
  }
  assert_true(applied_count > 0 && interface_count > 0)
  for
    (path, anchor) in [
      ("src/types.mbt", "pub fn options("),
      ("src/pack.mbt", "pub async fn pack("),
      ("src/metrics/encoder.mbt", "pub fn Encoder::count("),
      ("src/selection/select.mbt", "pub async fn select("),
    ] {
    guard files.get(path) is Some(String(text)) else {
      fail("Missing real MoonBit module: " + path)
    }
    assert_true(text.contains(anchor), msg=path + ":" + anchor)
  }
  let raw_tokens = packed_tokens(raw_error.text())
  let compressed_tokens = packed_tokens(error.text())
  assert_true(compressed_tokens < raw_tokens)
  println(
    "MoonBit self-pack: " +
    files.length().to_string() +
    " files, " +
    applied_count.to_string() +
    " applied, " +
    interface_count.to_string() +
    " interfaces, " +
    raw_tokens.to_string() +
    " -> " +
    compressed_tokens.to_string() +
    " complete tokens (full metadata).",
  )
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 2 || (args.length() == 3 && args[2] == "--xml-oracle") else {
    fail(
      "Usage: moon run --target native scripts/self-pack-test.mbtx NEW_OUTPUT_DIR [--xml-oracle]",
    )
  }
  let repo = @fs.realpath(".")
  let binary = repo +
    "/_build/native/release/build/cmd/moon-repomix/moon-repomix.exe"
  let vocabulary = repo + "/assets/tokenizer-o200k_base.tiktoken"
  // Keep evidence, and refuse to overwrite an existing output directory.
  @fs.mkdir(args[1])
  let output = @fs.realpath(args[1])
  let common = [repo, "--tokenizer-path", vocabulary]
  let xml_path = output + "/context.xml"
  let (xml_code, xml_out, xml_err) = @process.collect_output(
    binary,
    common + ["-o", xml_path],
    cwd=repo,
  )
  assert_eq(xml_code, 0, msg=xml_err.text())
  assert_eq(xml_out.text(), "")
  let xml = @fs.read_file(xml_path).text()
  @fs.write_file(output + "/xml.log", xml_err, create_mode=CreateNew)
  for
    path in [
      "README.md", "src/pack.mbt", "scripts/demo.mbtx", "docs/security.md",
    ] {
    assert_true(xml.contains("<file path=\"" + path + "\">"), msg=path)
  }
  assert_false(xml.contains("<file path=\"assets/"))
  assert_false(xml.contains("<file path=\"src/security/scan_test.mbt\">"))
  assert_true(xml_err.text().contains("pem-private-key"))
  // Literal positive samples live in this one fixture; other source files
  // must remain free of findings, including the real demo's concatenation.
  for line in xml_err.text().split("\n") {
    if line.has_prefix("Security ") {
      assert_true(
        line.contains("\"src/security/scan_test.mbt\""),
        msg=line.to_owned(),
      )
    }
  }
  assert_false(xml_err.text().contains("UnrepresentableText"))
  let (repeat_code, repeated, repeat_error) = @process.collect_output(
    binary,
    common + ["--stdout", "--quiet"],
    cwd=repo,
  )
  assert_eq(repeat_code, 0, msg=repeat_error.text())
  assert_eq(repeated.text(), xml)

  let md_path = output + "/context.md"
  let (md_code, _, md_error) = @process.collect_output(
    binary,
    common + ["--style", "markdown", "-o", md_path],
    cwd=repo,
  )
  assert_eq(md_code, 0, msg=md_error.text())
  let markdown = @fs.read_file(md_path).text()
  assert_true(markdown.contains("\n## File: scripts/demo.mbtx\n"))
  assert_false(markdown.contains("\n## File: assets/"))
  @fs.write_file(output + "/markdown.log", md_error, create_mode=CreateNew)

  let explicit = output + "/empty-config.json"
  @fs.write_file(explicit, "{}", create_mode=CreateNew)
  let golden_path = output + "/golden.xml"
  let (golden_code, _, golden_error) = @process.collect_output(
    binary,
    common +
    [
      "--config", explicit, "--include", "assets/tokenizer-golden.json", "-o", golden_path,
    ],
    cwd=repo,
  )
  assert_eq(golden_code, 0, msg=golden_error.text())
  assert_true(golden_error.text().contains("Packed 1 files,"))
  assert_false(golden_error.text().contains("UnrepresentableText"))
  assert_true(
    @fs.read_file(golden_path)
    .text()
    .contains("<file path=\"assets/tokenizer-golden.json\">"),
  )
  @fs.write_file(output + "/golden.log", golden_error, create_mode=CreateNew)
  if args.length() == 3 {
    let (parsed, _, errors) = @process.collect_output("xmllint", [
      "--nonet", "--noout", xml_path, golden_path,
    ])
    assert_eq(parsed, 0, msg=errors.text())
    let (readback, restored, error) = @process.collect_output("xmllint", [
      "--nonet", "--xpath", "string(/repository/files/file[@path='assets/tokenizer-golden.json'])",
      golden_path,
    ])
    assert_eq(readback, 0, msg=error.text())
    assert_eq(
      restored.text(),
      @fs.read_file(repo + "/assets/tokenizer-golden.json").text() + "\n",
    )
  }
  moonbit_self_pack(binary, common, repo, output)
  println(xml_err.text().split("\n").collect()[0])
  println(md_error.text().split("\n").collect()[0])
  println(
    "PASS: real repository, MoonBit raw/skeleton accepted-set equality, signatures/interfaces/original ranges, assets excluded, repeat/stdout, XML/Markdown and golden fixture",
  )
  println("Output: " + output)
}
